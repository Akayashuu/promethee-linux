{
	"$schema": "https://biomejs.dev/schemas/2.5.10/schema.json",
	"files": {
		"includes": ["**/*.js", "**/*.mjs", "**/*.json", "!dist", "!node_modules"]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended" }
	},
	"javascript": {
		"formatter": { "quoteStyle": "double" }
	}
}
