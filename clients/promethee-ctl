#!/usr/bin/env node
/**
 * promethee-ctl: the control socket from a shell.
 *
 * Bars that speak sockets should speak the socket; this is for the ones that
 * shell out (Waybar, eww, polybar) and for looking around by hand. It is the
 * reference implementation of docs/protocol.md, and deliberately depends on
 * nothing: node is already required to build this repository at all.
 *
 *   promethee-ctl state                    one JSON object, then exit
 *   promethee-ctl watch                    one per push, until interrupted
 *   promethee-ctl call <channel> [args…]   arguments are JSON, or plain strings
 *   promethee-ctl channels                 every channel the app registered
 *
 *   -s, --socket <path>   override $XDG_RUNTIME_DIR/promethee/control.sock
 *
 * Exit status: 0 done, 1 the call failed, 3 Promethee is not running.
 */
import fs from "node:fs";
import net from "node:net";
import os from "node:os";
import path from "node:path";
import { fileURLToPath } from "node:url";

const SELF = fileURLToPath(import.meta.url);

/** Longer than the server's own 15s call timeout, so its error wins the race. */
const CALL_TIMEOUT_MS = 20000;
/** The app stops and starts more often than a bar does. */
const RECONNECT_MS = 2000;

const EXIT_FAILED = 1;
const EXIT_NOT_RUNNING = 3;

function defaultSocketPath() {
	const runtime = process.env.XDG_RUNTIME_DIR || path.join(os.tmpdir(), `run-${process.getuid()}`);
	return path.join(runtime, "promethee", "control.sock");
}

/** Only these mean "nothing is listening"; anything else is a real failure. */
function isNotRunning(err) {
	return err?.code === "ENOENT" || err?.code === "ECONNREFUSED" || err?.code === "ECONNRESET";
}

/**
 * One connection, and the newline framing over it. Every command here is a
 * short conversation on a socket that may not exist yet, so connecting and
 * de-framing are the only things worth having in one place.
 */
class Control {
	constructor(socketPath) {
		this.socketPath = socketPath;
		this.socket = null;
		this.buffer = "";
		this.nextId = 1;
		this.pending = new Map();
		this.onEvent = null;
	}

	connect() {
		return new Promise((resolve, reject) => {
			const socket = net.connect(this.socketPath);
			socket.setEncoding("utf8");
			socket.on("connect", () => {
				this.socket = socket;
				resolve();
			});
			socket.on("data", (chunk) => this.#consume(chunk));
			socket.on("error", (err) => this.#fail(err, reject));
			// A close with no error still ends every call in flight.
			socket.on("close", () => this.#fail(new Error("connection closed"), reject));
		});
	}

	close() {
		this.socket?.destroy();
	}

	/** Resolves with the reply's `data`, rejects with its `error`. */
	call(channel, args = []) {
		const id = this.nextId++;
		return new Promise((resolve, reject) => {
			const timer = setTimeout(() => {
				this.pending.delete(id);
				reject(new Error(`${channel}: no reply after ${CALL_TIMEOUT_MS / 1000}s`));
			}, CALL_TIMEOUT_MS);

			this.pending.set(id, { resolve, reject, timer });
			this.socket.write(`${JSON.stringify({ id, channel, args })}\n`);
		});
	}

	#consume(chunk) {
		this.buffer += chunk;
		const lines = this.buffer.split("\n");
		this.buffer = lines.pop() ?? "";

		for (const line of lines) {
			if (line.trim().length === 0) continue;

			let message;
			try {
				message = JSON.parse(line);
			} catch {
				continue;
			}

			// Replies carry `ok`, pushes carry `event`; a reply to a request that
			// is no longer waiting is not an error, only late.
			if (message.event) {
				this.onEvent?.(message);
				continue;
			}
			const waiting = this.pending.get(message.id);
			if (!waiting) continue;

			this.pending.delete(message.id);
			clearTimeout(waiting.timer);
			if (message.ok) waiting.resolve(message.data ?? null);
			else waiting.reject(new Error(message.error || "call failed"));
		}
	}

	/** An error, or a close: either way nothing in flight will be answered. */
	#fail(err, reject) {
		for (const { reject: abort, timer } of this.pending.values()) {
			clearTimeout(timer);
			abort(err);
		}
		this.pending.clear();
		// Before the connection is up, the failure belongs to connect() itself;
		// after, that promise has settled and only the calls are left to reject.
		if (!this.socket) reject(err);
	}
}

function print(value) {
	process.stdout.write(`${JSON.stringify(value)}\n`);
}

/**
 * A bar has to render "not running" as readily as it renders a timer, so the
 * two are the same shape with one flag between them rather than a line of JSON
 * against an empty stream.
 */
function running(state) {
	return { running: true, ...state };
}

const NOT_RUNNING = { running: false };

/** Connect, ask one thing, print it, leave. */
async function once(socketPath, channel, args) {
	const control = new Control(socketPath);
	try {
		await control.connect();
	} catch (err) {
		if (!isNotRunning(err)) throw err;
		print(NOT_RUNNING);
		return EXIT_NOT_RUNNING;
	}

	try {
		const data = await control.call(channel, args);
		print(channel === "state" ? running(data) : data);
		return 0;
	} finally {
		control.close();
	}
}

/**
 * Follow the state until interrupted. The stream never ends on its own: the app
 * quitting is a line on it, not the end of it, because a bar that has to be
 * restarted alongside the app is a bar that will be wrong at some point.
 */
async function watch(socketPath) {
	let lastRunning = null;

	for (;;) {
		const control = new Control(socketPath);
		control.onEvent = (message) => {
			if (message.event !== "state") return;
			lastRunning = true;
			print(running(message.state));
		};

		try {
			await control.connect();
			// The connection pushes state on its own from here; wait for it to end.
			await new Promise((resolve) => {
				control.socket.on("close", resolve);
				control.socket.on("error", resolve);
			});
		} catch (err) {
			if (!isNotRunning(err)) throw err;
		}

		if (lastRunning !== false) {
			lastRunning = false;
			print(NOT_RUNNING);
		}
		await new Promise((resolve) => setTimeout(resolve, RECONNECT_MS));
	}
}

/** Arguments are JSON where they parse as JSON, and plain strings otherwise. */
function parseArg(text) {
	try {
		return JSON.parse(text);
	} catch {
		return text;
	}
}

/** The header comment is the help text, so the two cannot drift apart. */
function usage() {
	for (const line of fs.readFileSync(SELF, "utf8").split("\n").slice(2)) {
		if (line.startsWith(" */")) break;
		process.stdout.write(`${line.replace(/^ \* ?/, "")}\n`);
	}
}

async function main(argv) {
	let socketPath = defaultSocketPath();
	const rest = [];

	for (let i = 0; i < argv.length; i++) {
		const arg = argv[i];
		if (arg === "-s" || arg === "--socket") socketPath = argv[++i] ?? socketPath;
		else if (arg === "-h" || arg === "--help") {
			usage();
			return 0;
		} else rest.push(arg);
	}

	const [command, ...args] = rest;
	switch (command) {
		case "state":
			return once(socketPath, "state", []);
		case "channels":
			return once(socketPath, "channels", []);
		case "call": {
			const [channel, ...rawArgs] = args;
			if (!channel) throw new Error("call needs a channel");
			return once(socketPath, channel, rawArgs.map(parseArg));
		}
		case "watch":
			return watch(socketPath);
		default:
			usage();
			return command ? EXIT_FAILED : 0;
	}
}

// Set rather than exited on: process.exit() would drop whatever of stdout has
// not reached the pipe yet, and every command here ends by printing.
main(process.argv.slice(2)).then(
	(code) => {
		process.exitCode = code;
	},
	(err) => {
		process.stderr.write(`promethee-ctl: ${err?.message || err}\n`);
		process.exitCode = isNotRunning(err) ? EXIT_NOT_RUNNING : EXIT_FAILED;
	},
);
